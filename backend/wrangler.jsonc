{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "haodao-website-api",
  "main": "worker.mjs",
  "account_id": "d34ba66f84fbee22b81a79f894b6fba7",
  "compatibility_date": "2026-05-22",
  "vars": {"GOOGLE_CLIENT_ID":"363608409977-qs8memc8222337k3stu76i92ddbndhsb.apps.googleusercontent.com"},
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"api.haodao.org","custom_domain":true}],
  "d1_databases": [{"binding":"DB","database_name":"haodao-website","database_id":"584aa140-084e-4c3d-a020-2b0590191b4e"}],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"haodao-media"}],
  "triggers": {"crons":["*/5 * * * *"]}
}
